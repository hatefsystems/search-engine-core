<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ seo.title }}</title>
    <meta name="description" content="{{ seo.description }}">
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
{{ jsonld }}
    </script>
    
    <!-- Open Graph Meta Tags -->
    {% for tag in openGraph %}
    <meta property="{{ tag.property }}" content="{{ tag.content }}">
    {% endfor %}
    
    <!-- Twitter Card Meta Tags -->
    {% for tag in twitterCard %}
    <meta name="{{ tag.name }}" content="{{ tag.content }}">
    {% endfor %}
    
    <!-- Additional SEO -->
    <link rel="canonical" href="{{ baseUrl }}/{{ profile.slug }}">
    <meta name="robots" content="index, follow">
    
    <link rel="stylesheet" href="/assets/fonts/vazirmatn/Vazirmatn-FD-font-face.css">
    <link rel="stylesheet" href="/assets/css/profile-public.css?v=readability-1">
    <script src="/assets/js/profile-public-bootstrap.js?v=20261018-fallback-dom"></script>
    <script type="module" src="/assets/js/profile-public.js?v=20261017-first-paint" data-public-profile-module></script>
</head>
<body class="public-profile-page">
    {% if exists("publicPresentation") %}<template id="public-profile-data">{{ publicPresentation }}</template>{% endif %}
    <div id="public-profile-root" data-profile-render="loading">
        <div class="public-profile profile-loading" aria-busy="true" aria-label="بارگذاری پروفایل">
            <div class="pp-nav"><a class="pp-brand" href="/">هاتف</a></div>
            <main class="pp-main">
                <div class="pp-hero">
                    <div class="pp-avatar pp-skeleton" aria-hidden="true"></div>
                    <div class="pp-intro"><p role="status">در حال بارگذاری پروفایل…</p><div class="pp-skeleton pp-skeleton-title" aria-hidden="true"></div><div class="pp-skeleton pp-skeleton-line" aria-hidden="true"></div></div>
                </div>
                <div class="pp-section pp-skeleton-section" aria-hidden="true"><div class="pp-skeleton pp-skeleton-title"></div><div class="pp-skeleton pp-skeleton-line"></div></div>
            </main>
        </div>
    </div>
    <template id="public-profile-fallback">{% include "components/profile_public_readonly.inja" %}</template>
    <noscript><style>.profile-loading{display:none}</style>{% include "components/profile_public_readonly.inja" %}</noscript>
</body>
</html>
