<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ seo.title }}</title>
    <meta name="description" content="{{ seo.description }}">
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
{{ jsonld }}
    </script>
    
    <!-- Open Graph Meta Tags -->
    {% for tag in openGraph %}
    <meta property="{{ tag.property }}" content="{{ tag.content }}">
    {% endfor %}
    
    <!-- Twitter Card Meta Tags -->
    {% for tag in twitterCard %}
    <meta name="{{ tag.name }}" content="{{ tag.content }}">
    {% endfor %}
    
    <!-- Additional SEO -->
    <link rel="canonical" href="{{ baseUrl }}/{{ profile.slug }}">
    <meta name="robots" content="index, follow">
    
    <link rel="stylesheet" href="/assets/fonts/vazirmatn/Vazirmatn-FD-font-face.css">
    <link rel="stylesheet" href="/assets/css/profile-header.css">
    <script src="/assets/js/profile-header.js" defer></script>
    <link rel="stylesheet" href="/assets/css/profile-content.css">
    <link rel="stylesheet" href="/assets/css/profile-public.css">
    <script type="module" src="/assets/js/profile-public.js"></script>
</head>
<body>
    {% if exists("publicPresentation") %}<template id="public-profile-data">{{ publicPresentation }}</template>{% endif %}
    <main class="profile-page">
        {% include "components/profile_header.inja" %}
        <div class="content">
            <div class="profile-actions"><button type="button" id="share-profile" class="button">اشتراک‌گذاری صفحه</button>{% if existsIn(profile, "sections") and existsIn(profile.sections, "contacts") and length(profile.sections.contacts) > 0 %}<a href="#section-contacts">راه‌های ارتباطی</a>{% endif %}</div>
            {% if exists("advancedSections") %}{% include "components/profile_sections.inja" %}{% endif %}
            {% if (existsIn(profile, "bio") and profile.bio != "") %}
            <div class="profile-section">
                <h2>درباره من</h2>
                <p class="bio" dir="auto">{{ profile.bio }}</p>
            </div>
            {% endif %}
            
            {% if (existsIn(profile, "title") and profile.title != "") or (existsIn(profile, "company") and profile.company != "") or (existsIn(profile, "experienceLevel") and profile.experienceLevel != "") %}
            <div class="profile-section">
                <h2>اطلاعات حرفه‌ای</h2>
                <div class="info-grid">
                    {% if (existsIn(profile, "title") and profile.title != "") %}
                    <div class="info-item">
                        <div class="info-label">عنوان شغلی</div>
                        <div class="info-value" dir="auto">{{ profile.title }}</div>
                    </div>
                    {% endif %}
                    
                    {% if (existsIn(profile, "company") and profile.company != "") %}
                    <div class="info-item">
                        <div class="info-label">شرکت</div>
                        <div class="info-value" dir="auto">{{ profile.company }}</div>
                    </div>
                    {% endif %}
                    
                    {% if (existsIn(profile, "experienceLevel") and profile.experienceLevel != "") %}
                    <div class="info-item">
                        <div class="info-label">سطح تجربه</div>
                        <div class="info-value" dir="auto">{{ profile.experienceLevel }}</div>
                    </div>
                    {% endif %}
                </div>
            </div>
            {% endif %}
            
            {% if (existsIn(profile, "education") and profile.education != "") or (existsIn(profile, "school") and profile.school != "") %}
            <div class="profile-section">
                <h2>تحصیلات</h2>
                <div class="info-grid">
                    {% if (existsIn(profile, "education") and profile.education != "") %}
                    <div class="info-item">
                        <div class="info-label">مدرک تحصیلی</div>
                        <div class="info-value" dir="auto">{{ profile.education }}</div>
                    </div>
                    {% endif %}
                    
                    {% if (existsIn(profile, "school") and profile.school != "") %}
                    <div class="info-item">
                        <div class="info-label">دانشگاه یا مؤسسه</div>
                        <div class="info-value" dir="auto">{{ profile.school }}</div>
                    </div>
                    {% endif %}
                </div>
            </div>
            {% endif %}
            
            {% if length(links) > 0 %}
            <div class="profile-section">
                <h2>پیوندها</h2>
                <div class="links-section">
                    {% for link in links %}
                    <a href="/l/{{ link.id }}" class="link-block" target="_blank" rel="noopener noreferrer">
                        <div class="link-block-title" dir="auto">{{ link.title }}</div>
                        <div class="link-block-url" dir="ltr">{{ link.url }}</div>
                    </a>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>
        
        <footer class="profile-footer">ساخته‌شده با <a href="/" lang="en" dir="ltr">Hatef.ir</a></footer>
    </main>
</body>
</html>
