<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ seo.title }}</title>
    <meta name="description" content="{{ seo.description }}">
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
{{ jsonld }}
    </script>
    
    <!-- Open Graph Meta Tags -->
    {% for tag in openGraph %}
    <meta property="{{ tag.property }}" content="{{ tag.content }}">
    {% endfor %}
    
    <!-- Twitter Card Meta Tags -->
    {% for tag in twitterCard %}
    <meta name="{{ tag.name }}" content="{{ tag.content }}">
    {% endfor %}
    
    <!-- Additional SEO -->
    <link rel="canonical" href="{{ baseUrl }}/{{ profile.slug }}">
    <meta name="robots" content="index, follow">
    
    <link rel="stylesheet" href="/assets/fonts/vazirmatn/Vazirmatn-FD-font-face.css">
    <link rel="stylesheet" href="/assets/css/profile-public.css">
    <script type="module" src="/assets/js/profile-public.js"></script>
</head>
<body class="public-profile-page">
    {% if exists("publicPresentation") %}<template id="public-profile-data">{{ publicPresentation }}</template>{% endif %}
    <div id="public-profile-root" data-profile-render="server">
        <div class="public-profile" id="profile-home">
            <div class="pp-backdrop" aria-hidden="true">{% if existsIn(profile, "coverImageUrl") and profile.coverImageUrl != "" %}<img src="{{ profile.coverImageUrl }}" alt="" decoding="async">{% endif %}</div>
            <a class="pp-skip" href="#profile-content">رفتن به محتوای پروفایل</a>
            <nav class="pp-nav" aria-label="ناوبری پروفایل"><a class="pp-brand" href="/">هاتف</a><a href="#profile-content">پروفایل {{ headerName }}</a></nav>
            <main class="pp-main" id="profile-content" tabindex="-1">
                <section class="pp-hero" aria-label="معرفی">
                    <div class="pp-avatar">
                        <span class="pp-monogram"><svg class="avatar-placeholder" viewBox="0 0 100 100" width="100" height="100" aria-hidden="true"><circle cx="50" cy="36" r="17" fill="currentColor"/><path d="M18 89c0-24 14-34 32-34s32 10 32 34" fill="currentColor"/></svg></span>
                        {% if existsIn(profile, "avatarUrl") and profile.avatarUrl != "" %}<img src="{{ profile.avatarUrl }}" alt="تصویر پروفایل {{ headerName }}" decoding="async">{% endif %}
                    </div>
                    <div class="pp-intro">
                        {% if availabilityLabel != "" %}<span class="pp-availability">{{ availabilityLabel }}</span>{% endif %}
                        <h1 dir="auto">{{ headerName }}</h1>
                        {% if existsIn(profile, "englishName") and profile.englishName != "" %}<p class="pp-english"><bdi lang="en" dir="ltr">{{ profile.englishName }}</bdi></p>{% endif %}
                        {% if headerTitle != "" %}<p class="pp-title" dir="auto">{{ headerTitle }}</p>{% endif %}
                        {% if existsIn(profile, "tagline") and profile.tagline != "" and profile.tagline != headerTitle and profile.tagline != headerBio %}<p class="pp-bio" dir="auto">{{ profile.tagline }}</p>{% endif %}
                        {% if existsIn(profile, "location") and profile.location != "" %}<p class="pp-location" dir="auto">{{ profile.location }}</p>{% endif %}
                    </div>
                </section>
                <div class="pp-sections">
                    {% if headerBio != "" %}<section class="pp-section pp-about" id="section-about"><h2>درباره من</h2><p dir="auto">{{ headerBio }}</p></section>{% endif %}
                    {% if exists("advancedSections") %}{% include "components/profile_sections.inja" %}
                    {% else %}
                        {% if length(headerSkills) > 0 %}<section class="pp-section pp-section-skills" id="section-skills"><h2>مهارت‌های کلیدی</h2><div class="pp-card-list">{% for skill in headerSkills %}<article class="pp-card"><h3><bdi>{{ skill.name }}</bdi></h3>{% if skill.levelLabel != "" %}<p>{{ skill.levelLabel }}</p>{% endif %}</article>{% endfor %}</div></section>{% endif %}
                        {% if existsIn(profile, "education") and profile.education != "" %}<section class="pp-section" id="section-education"><h2>تحصیلات</h2><p dir="auto">{{ profile.education }}</p>{% if existsIn(profile, "school") and profile.school != "" %}<p dir="auto">{{ profile.school }}</p>{% endif %}</section>{% endif %}
                    {% endif %}
                    {% if length(links) > 0 %}<section class="pp-section" id="section-links"><h2>پیوندها</h2><div class="pp-contact-links">{% for link in links %}<div class="pp-contact-link"><a href="/l/{{ link.id }}" target="_blank" rel="noopener noreferrer" dir="auto">{{ link.title }}</a></div>{% endfor %}</div></section>{% endif %}
                </div>
                <footer class="pp-footer"><strong>هاتف</strong><small>ساخته‌شده با <a href="/" lang="en" dir="ltr">Hatef.ir</a></small></footer>
            </main>
        </div>
    </div>
</body>
</html>
