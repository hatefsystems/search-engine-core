{% for section in advancedSections %}
<section class="pp-section pp-section-{{ section.key }}" id="section-{{ section.key }}" aria-labelledby="heading-{{ section.key }}">
<h2 id="heading-{{ section.key }}">{{ section.label }}</h2>
<div class="pp-card-list">
{% for item in section.items %}
<article class="pp-card pp-card-{{ section.key }}" id="item-{{ section.key }}-{{ item.id }}">
<div class="pp-card-heading">
{% if item.iconUrl != "" %}<img class="profile-item-icon" src="{{ item.iconUrl }}" alt="" width="32" height="32" loading="lazy">{% endif %}
<h3 dir="auto">{{ item.heading }}</h3></div>{% if item.summary != "" %}<p class="content-summary" dir="auto">{{ item.summary }}</p>{% endif %}
<div class="pp-card-body"><dl class="content-fields">
{% for field in item.fields %}<div class="pp-fact"><dt>{{ field.label }}</dt><dd dir="auto">{% if field.url != "" %}<a href="{{ field.url }}" target="_blank" rel="noopener noreferrer">مشاهدهٔ منبع</a>{% else %}{{ field.value }}{% endif %}</dd></div>{% endfor %}
</dl>
{% if item.isRecommendation %}<p>این متن را صاحب پروفایل همراه با منبع ثبت کرده است؛ تأیید نویسنده توسط هاتف انجام نشده است.</p>{% endif %}
{% for link in item.links %}<a class="content-reference" href="{{ link.url }}" target="_blank" rel="noopener noreferrer" dir="auto">{{ link.title }}</a>{% endfor %}
<div class="content-gallery">{% for media in item.media %}<img src="{{ media.url }}" alt="{{ media.alt }}" loading="lazy">{% endfor %}</div>
</div></article>
{% endfor %}
</div>
{% if section.hasMore %}<noscript><p>برای نمایش ادامهٔ این بخش، جاوااسکریپت مرورگر را فعال کنید.</p></noscript>{% endif %}
</section>
{% endfor %}
