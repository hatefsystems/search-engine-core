# Copy to .env before starting Compose. Do not commit real credentials.
# Production uses docker-compose.yml and published linux/amd64 images.
# Local source build (also uses linux/amd64 on Apple Silicon):
# docker compose -f docker-compose.yml -f docker-compose.dev.yml build search-engine

# Core (the published port is fixed at 3000 in docker-compose.yml)
LOG_LEVEL=info
BASE_URL=http://localhost:3000

# MongoDB credentials, MONGODB_URI and SEARCH_REDIS_URI are currently set
# directly in docker-compose.yml. Setting them here does not override those
# service environment entries. Update the Compose configuration consistently
# when changing database credentials; existing volumes keep their credentials.

# SMTP (outbound email). Supply credentials to make delivery work.
# Blank credentials do not disable email endpoints or notification attempts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=60
SMTP_CONNECTION_TIMEOUT=20
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@example.com
FROM_NAME=Search Engine

# Crawler tuning (optional overrides; defaults applied by Compose)
# MAX_CONCURRENT_SESSIONS=5
# DEFAULT_REQUEST_TIMEOUT=60000
# SPA_RENDERING_ENABLED=true
# BROWSERLESS_URL=http://browserless:3000

# Security / compliance: set unique secrets before production use.
# COMPLIANCE_ENCRYPTION_KEY must be exactly 32 bytes. For example, generate
# a 32-character value with: openssl rand -hex 16
# COMPLIANCE_ENCRYPTION_KEY=replace-with-32-byte-random-value
# INTERNAL_API_KEY=replace-with-a-long-random-secret

# Optional local source build parallelism (docker-compose.dev.yml)
# BUILD_JOBS=2
